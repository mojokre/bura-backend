PORT=4000
NODE_ENV=development
FRONTEND_URL=https://thebura.online
CORS_ORIGINS=https://thebura.online

# Supabase — Google/Facebook Client ID/Secret go in Supabase Dashboard only
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=profile-images

# OAuth redirect target (hosted site — add same URL in Supabase Auth → Redirect URLs)
MOBILE_OAUTH_REDIRECT_URL=https://thebura.online/auth/callback
